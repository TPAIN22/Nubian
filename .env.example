
# ─── Maps (native rendering) ─────────────────────────────────────────────────
# CLIENT keys for the native Maps SDK. These ship inside the app binary and are
# extractable from it, so they are not secret in the way the backend geocoding
# key is — restrict them in Google Cloud Console instead:
#   Android → package name dev.expo.nubian + your SHA-1 signing certificate
#   iOS     → bundle identifier dev.expo.nubian
# Enable "Maps SDK for Android" / "Maps SDK for iOS" on these keys only.
#
# Injected at build time by app.config.js. On EAS set them as secrets:
#   eas secret:create --name GOOGLE_MAPS_ANDROID_API_KEY --value ...
#
# Without them the app still builds: Android shows a blank basemap and iOS
# falls back to Apple Maps. The picker keeps working either way.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Override the map renderer for a build. Defaults to `native` everywhere except
# web. Set to `webview` for Expo Go, where the native module is unavailable.
# EXPO_PUBLIC_MAP_RENDERER=webview
